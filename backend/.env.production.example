NODE_ENV=production
PORT=3001
FRONTEND_ORIGIN=https://onboarding.example.com
MONGODB_URI=mongodb+srv://service-user:replace-password@cluster.example.com/intern_onboarding
JWT_SECRET=replace-with-output-from-openssl-rand-base64-48

FILE_STORAGE_DRIVER=owncloud
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/service-user/
WEBDAV_USERNAME=service-user
WEBDAV_PASSWORD=replace-with-owncloud-app-passcode
WEBDAV_REMOTE_PATH=student-onboarding-production

ID_CARD_WATERMARK_TEXT=仅限学生入职登记使用 · {studentName} · {date}
ATTENDANCE_TIMEZONE=Asia/Shanghai
ATTENDANCE_ON_TIME_BEFORE=10:01
ATTENDANCE_LATE_THROUGH=10:30
ATTENDANCE_CHECK_IN_CLOSE_AFTER=11:00
ATTENDANCE_CRON_ENABLED=true

# 必须等于浏览器到 NestJS 之间的实际受信代理层数。
TRUST_PROXY_HOPS=1
