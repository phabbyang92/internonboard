{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:isolated": "node --env-file=.env.e2e ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "test:owncloud:e2e": "node --env-file=.env.e2e -r ts-node/register -r tsconfig-paths/register scripts/verify-owncloud-e2e-storage.ts",
    "create:hr": "ts-node -r tsconfig-paths/register scripts/create-hr-user.ts",
    "migrate:work-location-history": "ts-node -r tsconfig-paths/register scripts/backfill-work-location-history.ts",
    "migrate:work-location-names": "ts-node -r tsconfig-paths/register scripts/migrate-work-location-names.ts",
    "migrate:remove-marital-status": "ts-node -r tsconfig-paths/register scripts/remove-marital-status.ts",
    "migrate:student-owners": "ts-node -r tsconfig-paths/register scripts/backfill-student-owners.ts",
    "migrate:attendance-regions": "ts-node -r tsconfig-paths/register scripts/migrate-attendance-regions.ts",
    "sync:office-networks": "ts-node -r tsconfig-paths/register scripts/sync-office-networks.ts",
    "verify:release": "node --env-file=.env.production -r ts-node/register -r tsconfig-paths/register scripts/verify-release-readiness.ts",
    "verify:post-deploy": "node -r ts-node/register -r tsconfig-paths/register scripts/verify-post-deploy.ts",
    "backup:mongodb": "node --env-file=.env.production -r ts-node/register -r tsconfig-paths/register scripts/backup-mongodb.ts",
    "verify:mongodb-backup": "node --env-file=.env.restore-verification -r ts-node/register -r tsconfig-paths/register scripts/verify-mongodb-backup.ts",
    "verify:mongodb:production": "node --env-file=.env.production -r ts-node/register -r tsconfig-paths/register scripts/verify-mongodb-release.ts",
    "verify:owncloud": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/verify-owncloud-storage.ts",
    "verify:owncloud:production": "node --env-file=.env.production -r ts-node/register -r tsconfig-paths/register scripts/verify-owncloud-storage.ts",
    "migrate:owncloud": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/migrate-local-files-to-owncloud.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.7.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@2.1.2": "2.1.4",
    "brace-expansion@2.1.3": "2.1.4",
    "brace-expansion@5.0.8": "5.0.9",
    "fast-uri@3.1.4": "3.1.5",
    "js-yaml@3.15.0": "3.15.1",
    "js-yaml@4.3.0": "4.3.1",
    "readdir-glob": {
      "brace-expansion": "2.1.4"
    },
    "uuid@8.3.2": "11.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
