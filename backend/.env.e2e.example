# 复制为 .env.e2e。该文件只允许指向可清理的测试资源。
E2E_MONGODB_URI=mongodb://127.0.0.1:27017/intern_onboarding_e2e
E2E_UPLOAD_DIR=/tmp/intern-onboarding-e2e-local

# ownCloud 可以复用本地测试服务账号，但远程路径必须是独立的 e2e 子目录。
E2E_WEBDAV_URL=http://localhost:8080/remote.php/dav/files/admin/
E2E_WEBDAV_USERNAME=admin
E2E_WEBDAV_PASSWORD=replace-with-owncloud-test-app-passcode
E2E_WEBDAV_REMOTE_PATH=student-onboarding-system-e2e/manual
